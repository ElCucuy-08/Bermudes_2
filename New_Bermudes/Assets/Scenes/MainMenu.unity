  m_Text: "\n\u0420\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A\u0438:\r\n\u0413\u0435\u0440\u0430\u0441\u0438\u043C\u043E\u0432
    \u041C\u0430\u0442\u0432\u0435\u0439 - \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0441\u0442\r\n\u0411\u043E\u0439\u043A\u043E
    \u0414\u043C\u0438\u0442\u0440\u0438\u0439 - \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0441\u0442\r\n\u0427\u0443\u0432\u0430\u043A
    \u041A\u0438\u0440\u0438\u043B\u043B - \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0441\u0442/\u0434\u0438\u0437\u0430\u0439\u043D\u0435\u0440\r\n\u0421\u0430\u0432\u0438\u0446\u043A\u0438\u0439
    \u0414\u043C\u0438\u0442\u0440\u0438\u0439 - \u0434\u0438\u0437\u0430\u0439\u043D\u0435\u0440\r\n\u0421\u044B\u0440\u043E\u043C\u043E\u043B\u043E\u0442
    \u0410\u043B\u0435\u043A\u0441\u0435\u0439 - \u0434\u0438\u0437\u0430\u0439\u043D\u0435\u0440/\u0434\u0438\u0430\u043B\u043E\u0433\r\n\u041D\u0430\u0437\u0430\u0440\u043E\u0432
    \u041F\u0430\u0432\u0435\u043B - \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0441\u0442/\u0434\u0438\u0437\u0430\u0439\u043D\u0435\u0440\r\n\r\n\u041E\u0437\u0432\u0443\u0447\u043A\u0430:\r\n\u0421\u0430\u0432\u0438\u0446\u043A\u0438\u0439
    \u0414\u043C\u0438\u0442\u0440\u0438\u0439 - \u0413\u043B\u0430\u0432\u043D\u044B\u0439
    \u0433\u0435\u0440\u043E\u0439\r\n\u0427\u0443\u0432\u0430\u043A \u041A\u0438\u0440\u0438\u043B\u043B
    - \u0413\u0438\u0434\r\n\u0421\u044B\u0440\u043E\u043C\u043E\u043B\u043E\u0442
    \u0410\u043B\u0435\u043A\u0441\u0435\u0439 - \u0411\u0430\u0431\u043A\u0430\r\n\u041D\u0438\u043A\u0438\u0442\u0430
    \u0428\u0430\u043C\u0448\u0443\u0440\u043E\u0432 - \u041F\u0441\u0438\u0445\r\n\u0421\u0430\u0432\u0438\u0446\u043A\u0438\u0439
    \u0414\u043C\u0438\u0442\u0440\u0438\u0439 - \u041F\u0440\u043E\u043B\u043E\u0433\r\n\r\n\u0420\u0443\u043A\u043E\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u0438:\r\n\u041D\u0430\u0437\u0430\u0440\u043E\u0432
    \u041F\u0430\u0432\u0435\u043B - \u041B\u0418\u0414 \u043F\u0440\u043E\u0435\u043A\u0442\u0430\r\n\u041D\u0438\u043A\u0438\u0442\u0430
    \u0428\u0430\u043C\u0448\u0443\u0440\u043E\u0432 - \u043F\u0440\u043E\u0434\u0436\u0435\u043A\u0442
    \u043C\u0435\u043D\u0435\u0434\u0436\u0435\u0440\r\n"
